<div class="bg-gradient-to-br from-indigo-50 via-white to-blue-50">
  <div class="mx-auto flex min-h-[85vh] max-w-7xl items-center justify-center px-6">
    <div class="max-w-3xl space-y-8 text-center">
      <h1 class="text-5xl font-extrabold tracking-tight text-gray-900 sm:text-6xl">
        Welcome to
        <span class="text-indigo-600">My App</span>
      </h1>

      <p class="text-xl leading-8 text-gray-600">
        Share your ideas, read articles from the community, and connect with
        other writers.
      </p>

      <% unless logged_in? %>
        <div class="space-y-8 flex flex-col justify-center gap-4 sm:flex-row">
          <%= link_to "Sign Up",
                      signup_path,
                      class: "rounded-lg bg-indigo-600 px-8 py-3 text-lg font-semibold text-white shadow-md transition hover:bg-indigo-700" %>
        </div>

        <p class="text-gray-500">
          Already have an account?
          <%= link_to "Log in",
                      login_path,
                      class: "font-semibold text-indigo-600 hover:text-indigo-700" %>
        </p>
      <% end %>
    </div>
  </div>
</div>
