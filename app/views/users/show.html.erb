<%= render 'layouts/navigation' %>

<% content_for :title, @user.username %>

<div class="mx-auto max-w-3xl px-4 py-10">
  <!-- Profile Card -->
  <div class="rounded-2xl bg-white p-8 shadow-lg">

    <!-- Avatar -->
    <div class="flex justify-center">
      <div class="overflow-hidden rounded-full ring-4 ring-indigo-100">
        <%= gravatar_for @user %>
      </div>
    </div>

    <%= render 'articles/article' %>

    <!-- User Info -->
    <div class="mt-6 text-center">
      <%= render @user %>
    </div>

    <br>

    <!-- Divider -->
    <div class="my-8 border-t border-gray-200"></div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap justify-center gap-3">

      <% if logged_in? && (@user == current_user || current_user.admin?)  %>
        <%= link_to "✏️ Edit User",
                    edit_user_path(@user),
                    class: "rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white shadow hover:bg-indigo-700 transition" %>

        <%= button_to "🗑️ Delete User",
                      @user,
                      method: :delete,
                      data: { turbo_confirm: "Are you sure?" },
                      class: "rounded-lg bg-red-600 px-6 py-2.5 font-medium text-white shadow hover:bg-red-700 transition" %>
      <% end %>

      <%= link_to "Back to Users",
                  users_path,
                  class: "rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white hover:bg-indigo-700 transition" %>

      <%= link_to "Home",
                  articles_path,
                  class: "rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white hover:bg-indigo-700 transition" %>

    </div>
    <br>
  </div>
</div>

