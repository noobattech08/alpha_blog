<%#= link_to "New user", signup_path %>

<%= render 'layouts/navigation' %>

<% content_for :title, "Users" %>

<div class="mx-auto max-w-3xl px-4 py-10">
  <!-- Users -->
  <div id="users" class="space-y-6" >
    <% @users.each do |user| %>
      <div class="rounded-xl bg-white p-6 shadow-md transition hover:shadow-lg">
        <%= render user %>

        <div class="mt-5 flex justify-end gap-3">
          <%= link_to "Show User",
                      user,
                      class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" %>
          <% if logged_in? && (user == current_user || current_user.admin?)  %>
            <%= link_to "Edit User",
                        edit_user_path(user),
                        class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" %>
            <%= button_to "Delete User",
                          user,
                          method: :delete,
                          data: { turbo_confirm: "Are you sure?" },
                          class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 transition" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <br>

  <!-- Bottom Action -->
  <!-- This Action must be explicitly available for only the Admin not any guest or even logged-in user until they have
   the right permissions to create users -->

  <div class="mt-10 border-t pt-6">
    <%= link_to "New User",
                signup_path,
                class: "inline-flex items-center rounded-lg bg-green-600 px-5 py-3 font-medium text-black shadow hover:bg-green-700 transition" %>
  </div>
</div>
