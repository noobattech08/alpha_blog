<nav class="bg-white shadow-sm border-b border-gray-200">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">

    <!-- Logo -->
    <%= link_to articles_path, class: "text-2xl font-bold text-indigo-600 hover:text-indigo-700" do %>
      My App
    <% end %>

    <!-- Navigation Links -->
    <div class="flex items-center space-x-6">
      <%= link_to "Articles", articles_path,
                  class: "text-gray-700 hover:text-indigo-600 font-medium transition" %>

      <%= link_to "Users", users_path,
                  class: "text-gray-700 hover:text-indigo-600 font-medium transition" %>
      <% if logged_in? %>
        <%= link_to "#{current_user.admin? ? '(Admin) ' : ''}Profile [#{current_user.username}]",
                    user_path(current_user),
                    class: "text-blue-600 font-medium underline" %>
        <%= link_to "New Article", new_article_path,
                    class: "rounded-lg bg-indigo-600 px-4 py-2 text-white font-medium hover:bg-indigo-700 transition" %>
        <%= button_to "Logout",
                      logout_path,
                      method: :delete,
                      class: "rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white hover:bg-indigo-700
                    transition" %>
      <% else %>
        <%= link_to "Login", login_path,
                    class: "text-gray-700 hover:text-indigo-600 font-medium transition" %>
      <% end %>
    </div>
  </div>
</nav>
